<?xml version="1.0" encoding="UTF-8"?>

<?import fr.nedjar.vigiechiro.audio.AudioView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<!--
  Le composant AudioView s'insère directement en FXML (constructeur sans argument).
  Le contrôleur câble ensuite la source via setAudioFile(...) et observe ses propriétés.
-->
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.nedjar.vigiechiro.demo.DemoController"
            onDragOver="#surGlisser" onDragDropped="#surDepot"
            prefWidth="900" prefHeight="600">

  <top>
    <HBox spacing="12" alignment="CENTER_LEFT">
      <padding>
        <Insets top="10" right="12" bottom="10" left="12"/>
      </padding>
      <Button text="Ouvrir un fichier WAV..." onAction="#ouvrir"/>
      <Label fx:id="fichierLabel" text="(ouvrez un WAV, ou glissez-le sur la fenêtre)"/>
      <Region HBox.hgrow="ALWAYS"/>
      <Button fx:id="themeBouton" text="Thème clair" onAction="#basculerTheme"/>
    </HBox>
  </top>

  <center>
    <AudioView fx:id="audioView"/>
  </center>

  <!-- Barre d'etat : l'etat de lecture observe via l'API du composant
       (playingProperty / currentTimeProperty / durationProperty). -->
  <bottom>
    <HBox alignment="CENTER_LEFT"
          style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-width: 1 0 0 0;">
      <padding>
        <Insets top="6" right="12" bottom="6" left="12"/>
      </padding>
      <Label fx:id="etatLabel" text="Aucun fichier chargé"/>
    </HBox>
  </bottom>

</BorderPane>
