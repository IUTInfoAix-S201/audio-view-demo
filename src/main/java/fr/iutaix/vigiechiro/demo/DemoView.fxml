<?xml version="1.0" encoding="UTF-8"?>

<?import fr.iutaix.vigiechiro.audio.AudioView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<!--
  Le composant AudioView s'insère directement en FXML (constructeur sans argument).
  Le contrôleur câble ensuite la source via setAudioFile(...) et observe ses propriétés.
-->
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.iutaix.vigiechiro.demo.DemoController"
            prefWidth="900" prefHeight="600">

  <top>
    <HBox spacing="12" alignment="CENTER_LEFT">
      <padding>
        <Insets top="10" right="12" bottom="10" left="12"/>
      </padding>
      <Button text="Ouvrir un fichier WAV..." onAction="#ouvrir"/>
      <Label fx:id="fichierLabel" text="(aucun fichier ouvert)"/>
      <Label fx:id="tempsLabel"/>
    </HBox>
  </top>

  <center>
    <AudioView fx:id="audioView"/>
  </center>

</BorderPane>
