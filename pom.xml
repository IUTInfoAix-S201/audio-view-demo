<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>fr.nedjar.vigiechiro</groupId>
  <artifactId>audio-view-demo</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>VigieChiro Audio View - Demo</name>
  <description>Application JavaFX d'exemple consommant le composant audio-view via JitPack.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>

    <javafx.version>25</javafx.version>
    <!-- audio-view sur Maven Central (groupId fr.nedjar.vigiechiro). 1.12.0 : normalisation peak
         à la lecture (#32), lecture en boucle + mode daltonien assorti au thème, et mode sombre
         par défaut en inferno (#34). -->
    <audio.view.version>1.13.1</audio.view.version>

    <maven.compiler.plugin.version>3.15.0</maven.compiler.plugin.version>
    <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>

    <!-- Outils qualité (alignés sur les TP R2.02 / R2.03 et sur la lib audio-view). -->
    <spotless.maven.plugin.version>3.8.0</spotless.maven.plugin.version>
    <google.java.format.version>1.35.0</google.java.format.version>
    <git.build.hook.plugin.version>3.6.0</git.build.hook.plugin.version>
    <maven.pmd.plugin.version>3.28.0</maven.pmd.plugin.version>
    <maven.enforcer.plugin.version>3.6.3</maven.enforcer.plugin.version>
    <spotbugs.maven.plugin.version>4.10.4.0</spotbugs.maven.plugin.version>
  </properties>

  <dependencies>
    <!-- Le composant est publie sur Maven Central depuis v1.10.1 ; groupId au domaine
         maitrise fr.nedjar.vigiechiro. JitPack reste actif sous le groupId
         com.github.IUTInfoAix-S201 mais Central est desormais la voie privilegiee. -->
    <dependency>
      <groupId>fr.nedjar.vigiechiro</groupId>
      <artifactId>audio-view</artifactId>
      <version>${audio.view.version}</version>
    </dependency>

    <!-- JavaFX apporte par le projet consommateur (le javafx-maven-plugin gere
         les natifs par OS au lancement). audio-view declare JavaFX en provided. -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- FXML / CSS co-localises a cote des classes Java (convention des TP R2.02). -->
      <resource>
        <directory>src/main/java</directory>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven.compiler.plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>

      <!-- Lancement : mvn javafx:run -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>${javafx.maven.plugin.version}</version>
        <configuration>
          <mainClass>fr.nedjar.vigiechiro.demo/fr.nedjar.vigiechiro.demo.DemoApp</mainClass>
          <options>
            <option>--enable-native-access=javafx.graphics</option>
            <!-- Linux : evite que le "grab" d'entree de JavaFX se coince et gele
                 le dialogue natif du FileChooser (popup/dialogue qu'on ne peut
                 plus qu'annuler). Symptome intermittent, dependant du gestionnaire
                 de fenetres. -->
            <option>-Dglass.disableGrab=true</option>
          </options>
        </configuration>
      </plugin>

      <!-- Formatage Google Java Format. "./mvnw spotless:apply" avant commit ;
           appele automatiquement par le hook .githooks/pre-commit. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.maven.plugin.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google.java.format.version}</version>
            </googleJavaFormat>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
      </plugin>

      <!-- git-build-hook : configure core.hooksPath=.githooks au premier ./mvnw. -->
      <plugin>
        <groupId>com.rudikershaw.gitbuildhook</groupId>
        <artifactId>git-build-hook-maven-plugin</artifactId>
        <version>${git.build.hook.plugin.version}</version>
        <configuration>
          <gitConfig>
            <core.hooksPath>.githooks</core.hooksPath>
          </gitConfig>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>configure</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- PMD : report en "verify", strict via le profil quality-gate. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>${maven.pmd.plugin.version}</version>
        <configuration>
          <rulesets>
            <ruleset>${project.basedir}/pmd-ruleset.xml</ruleset>
          </rulesets>
          <printFailingErrors>true</printFailingErrors>
          <failOnViolation>false</failOnViolation>
          <linkXRef>false</linkXRef>
          <targetJdk>25</targetJdk>
          <includeTests>false</includeTests>
        </configuration>
        <executions>
          <execution>
            <id>pmd-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Enforcer : JDK 25 + Maven. (Pas d'interdiction openjfx : ici la demo,
           consommatrice, apporte legitimement JavaFX en scope compile.) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven.enforcer.plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-invariants</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- SpotBugs : analyse statique sur le bytecode, bloquant en "verify". -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>${spotbugs.maven.plugin.version}</version>
        <configuration>
          <effort>Max</effort>
          <threshold>Medium</threshold>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Quality gate : PMD bloque sur violation. Active via "./mvnw -Pquality-gate verify"
         et par la CI. -->
    <profile>
      <id>quality-gate</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-pmd-plugin</artifactId>
            <configuration>
              <failOnViolation>true</failOnViolation>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Capture : régénère l'aperçu du README d'audio-view par rendu hors-écran de l'AudioView.
         Voir scripts/capture-apercu.sh. Usage direct :
           xvfb-run -a mvn -Pcapture javafx:run -Dcapture.wav=<WAV> -Dcapture.out=<sortie.png> -->
    <profile>
      <id>capture</id>
      <properties>
        <capture.wav/>
        <capture.out>apercu.png</capture.out>
        <capture.freqZoom>5</capture.freqZoom>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-maven-plugin</artifactId>
            <configuration>
              <mainClass>fr.nedjar.vigiechiro.demo/fr.nedjar.vigiechiro.demo.CaptureApercu</mainClass>
              <options combine.self="override">
                <option>--enable-native-access=javafx.graphics</option>
                <option>-Dcapture.wav=${capture.wav}</option>
                <option>-Dcapture.out=${capture.out}</option>
                <option>-Dcapture.freqZoom=${capture.freqZoom}</option>
              </options>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
