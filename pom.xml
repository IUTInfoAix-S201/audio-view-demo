<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>fr.iutaix.vigiechiro</groupId>
  <artifactId>audio-view-demo</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>VigieChiro Audio View - Demo</name>
  <description>Application JavaFX d'exemple consommant le composant audio-view via JitPack.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>

    <javafx.version>25</javafx.version>
    <audio.view.version>v1.0.0</audio.view.version>

    <maven.compiler.plugin.version>3.15.0</maven.compiler.plugin.version>
    <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>
  </properties>

  <!-- JitPack : c'est de la que provient le composant audio-view (boite noire). -->
  <repositories>
    <repository>
      <id>jitpack.io</id>
      <url>https://jitpack.io</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- Le composant publie sur JitPack. Le groupId est impose par JitPack
         (com.github.<organisation>), l'artifactId est le nom du depot. -->
    <dependency>
      <groupId>com.github.IUTInfoAix-S201</groupId>
      <artifactId>audio-view</artifactId>
      <version>${audio.view.version}</version>
    </dependency>

    <!-- JavaFX apporte par le projet consommateur (le javafx-maven-plugin gere
         les natifs par OS au lancement). audio-view declare JavaFX en provided. -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- FXML / CSS co-localises a cote des classes Java (convention des TP R2.02). -->
      <resource>
        <directory>src/main/java</directory>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven.compiler.plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>

      <!-- Lancement : mvn javafx:run -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>${javafx.maven.plugin.version}</version>
        <configuration>
          <mainClass>fr.iutaix.vigiechiro.demo/fr.iutaix.vigiechiro.demo.DemoApp</mainClass>
          <options>
            <option>--enable-native-access=javafx.graphics</option>
            <!-- Linux : evite que le "grab" d'entree de JavaFX se coince et gele
                 le dialogue natif du FileChooser (popup/dialogue qu'on ne peut
                 plus qu'annuler). Symptome intermittent, dependant du gestionnaire
                 de fenetres. -->
            <option>-Dglass.disableGrab=true</option>
          </options>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
